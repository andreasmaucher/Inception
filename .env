# Inception Project Environment Variables
# Copy this file to .env and customize the values

# Domain Configuration
DOMAIN_NAME=your-domain.42.fr

# MariaDB Configuration
MYSQL_DATABASE=wordpress
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_strong_password
MYSQL_ROOT_PASSWORD=your_very_strong_root_password

# WordPress Database Configuration
WP_DB_NAME=wordpress
WP_DB_USER=your_db_user
WP_DB_PASSWORD=your_strong_password
WP_DB_HOST=mariadb

# WordPress Site Configuration
WP_SITE_TITLE=Your Site Title
WP_ADMIN_USER=your_admin_username
WP_ADMIN_PASSWORD=your_admin_password
WP_ADMIN_EMAIL=your_email@your-domain.42.fr
